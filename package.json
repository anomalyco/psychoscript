{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "psychoscript",
  "version": "0.1.0",
  "description": "A confined, resumable JavaScript interpreter for Effect hosts",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/psychoscript.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:roundtrip": "PSYCHOSCRIPT_ROUNDTRIP=1 bun test",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "acorn": "8.15.0"
  },
  "peerDependencies": {
    "effect": "^4.1.0"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.4.3",
    "@typescript/native": "npm:typescript@7.1.0-beta",
    "effect": "4.1.0"
  }
}
