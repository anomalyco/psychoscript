{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@anomalyco/sigil",
  "version": "0.1.0",
  "description": "A confined JavaScript runtime for programs that call schema-described tools",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/sigil.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "pack": "bun run script/pack.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:roundtrip": "CODEMODE_ROUNDTRIP=1 bun test"
  },
  "dependencies": {
    "acorn": "8.15.0",
    "effect": "4.1.0"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.4.3",
    "@typescript/native": "npm:typescript@7.1.0-beta"
  }
}
