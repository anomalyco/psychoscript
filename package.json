{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "psychoscript",
  "version": "0.0.0",
  "description": "A confined, resumable JavaScript interpreter: programs call only the functions the host gives them, and a run can be suspended to bytes and resumed later",
  "keywords": [
    "javascript",
    "interpreter",
    "sandbox",
    "bytecode",
    "vm",
    "resumable",
    "snapshot",
    "effect"
  ],
  "homepage": "https://psychoscript.com",
  "bugs": {
    "url": "https://github.com/anomalyco/psychoscript/issues"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=24",
    "bun": ">=1.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/psychoscript.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./effect": {
      "types": "./dist/effect/index.d.ts",
      "default": "./dist/effect/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "pack": "bun run script/pack.ts",
    "check": "bun run typecheck && bun test && bun run test:roundtrip && bun run pack",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:roundtrip": "PSYCHOSCRIPT_ROUNDTRIP=1 bun test",
    "bench": "bun run script/bench.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "acorn": "8.15.0"
  },
  "peerDependencies": {
    "effect": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.4.3",
    "@typescript/native": "npm:typescript@7.1.0-beta",
    "effect": "4.1.0"
  }
}
